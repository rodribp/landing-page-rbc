---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/atoms/Button.astro";
import Service from "@/components/Service.astro";
import QuoteForm from "@/components/QuoteForm.astro";
import Carrousel from "@/components/Carrousel.astro";
import "@/styles/animations.css";
import { SERVICES } from "@/utils/content";
import { CONTACT_EMAIL, CONTACT_PHONE } from "@/utils/global_variables";

const companies = Array.from({ length: 18 }, (_, i) => i + 1);
---

<Layout>
  <!-- First view section with video -->
  <section class="relative h-[98vh] overflow-hidden">
    <video
      class="absolute inset-0 h-full w-full object-cover object-[15%]"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
    >
      <source src="/video/inicio.webm" type="video/webm" />
      <source src="/video/inicio.mp4" type="video/mp4" />
    </video>

    <div class="absolute inset-0 bg-black/60"></div>

    <div class="mx-layout absolute top-1/2 left-0 block w-3/4 -translate-y-[60%] md:w-[35%]">
      <h1 class="text-titles animate-fade-up mb-4 text-white delay-100">Permítenos ser parte de tu equipo</h1>
      <h3 class="text-subtitles animate-fade-up mb-4 text-white delay-400">
        Servicios profesionales en el área de la construcción.
      </h3>
      <Button href="#contacto" class="fade-in-on-load">¡Cotiza ya!</Button>
    </div>
    <!-- Boton sobre nosotros -->
    <a
      href="#sobre-nosotros"
      class="animate-bounce-slow pause-on-hover absolute bottom-6 flex w-full flex-col items-center justify-center space-y-2 text-white delay-800"
    >
      <p class="drop-shadow-[0_0_6px_rgba(255,255,255,1)]">Sobre Nosotros</p>
      <img src="/icons/arrowdown.svg" alt="arrow down" />
    </a>
  </section>

  <!-- Trusted companies section -->
  <section id="sobre-nosotros" class="mx-layout relative my-10 flex flex-col items-center justify-center text-center">
    <p class="text-paragraphs text-primary">
      Nuestros servicios han estado presentes en diferentes proyectos y empresas
    </p>
    <div class="mt-5 flex flex-row flex-wrap items-center justify-center space-y-2 space-x-2">
      {
        companies.map((n) => (
          <img
            src={`/trusted_companies/${n}.png`}
            alt={`Compañia ${n}`}
            class="h-auto md:h-16 w-[6%] object-contain object-center md:w-[9%]"
          />
        ))
      }
    </div>
  </section>

  <!-- Portfolio carrousel section -->
  <!-- <section id="sobre-nosotros" class="my-10 flex flex-col space-y-4 lg:flex-row lg:gap-15">
    <div class="flex w-full flex-col items-start justify-center space-y-6 px-5 md:px-8 lg:w-[30%] lg:px-0 lg:pl-18">
      <h2 class="text-primary">
        <span>
          Descubre nuestros<span></span>
          <p class="text-3xl font-bold">PROYECTOS COMPLETADOS</p>
        </span>
      </h2>
      <p class="text-paragraphs text-primary">
        Explora nuestra experiencia y soluciones en ingeniería y construcción a través de nuestro.
      </p>
      <Button href="/proyectos">Portafolio de proyectos</Button>
    </div>
    <div class="relative w-full px-5 md:px-8 lg:w-[65%] lg:px-0">
      <Carrousel />
    </div>
  </section> -->

  <!-- About us section -->
  <section class="mx-layout relative my-10 flex flex-col space-y-4 lg:flex-row lg:gap-15">
    <img src="/img/collage.webp" alt="Collage img" class="h-auto w-full lg:w-[45%]" />
    <div class="flex flex-col justify-center space-y-6">
      <div class="flex w-full flex-col justify-center space-y-2">
        <h2 class="text-primary text-4xl font-bold">Tu aliado estratégico</h2>
        <h3 class="text-subtitles">para ejecutar tus proyectos</h3>
      </div>
      <p class="text-paragraphs">
        Somos una empresa salvadoreña con amplia experiencia en el sector de la construcción, especializada en
        soluciones integrales.
      </p>
      <div class="mt-6 flex w-full gap-2">
        <Button href="#servicios" data-goto-service="0" class="flex-1 px-2! md:px-6!">
          <div class="flex flex-col items-center space-y-2 text-center text-xs font-normal">
            <img src="/icons/structure.svg" alt="" />
            <p>Servicios de metal mecánica</p>
          </div>
        </Button>
        <Button href="#servicios" data-goto-service="1" class="flex-1 px-2! md:px-6!">
          <div class="flex flex-col items-center space-y-2 text-center text-xs font-normal">
            <img src="/icons/pipeline.svg" alt="" />
            <p>Estructuras, tuberías y maquinado</p>
          </div>
        </Button>
        <Button href="#servicios" data-goto-service="2" class="flex-1 px-2! md:px-6!">
          <div class="flex flex-col items-center space-y-2 text-center text-xs font-normal">
            <img src="/icons/bolt.svg" alt="" />
            <p>Electricidad residencial e industrial</p>
          </div>
        </Button>
      </div>
    </div>
  </section>

  <!-- Services carousel section -->
  <section id="servicios" class="relative h-screen overflow-hidden bg-black text-white">
    {
      SERVICES.map((service) => (
        <Service
          title={service.title}
          description={service.description}
          details={service.details}
          index={SERVICES.indexOf(service)}
        />
      ))
    }

    <!-- Click hint -->
    <p class="absolute top-4 left-1/2 z-10 -translate-x-1/2 text-xs text-white/50 select-none">
      Haga click en cualquier parte para ver el siguiente servicio
    </p>

    <!-- Dots navigation (bottom center) -->
    <div class="absolute bottom-6 left-1/2 z-10 flex -translate-x-1/2 flex-row gap-3">
      {
        SERVICES.map((_, i) => (
          <button
            class="service-dot h-2.5 w-2.5 cursor-pointer rounded-full border border-white/60 bg-transparent transition-all duration-300"
            data-dot={i}
            aria-label={`Go to service ${i + 1}`}
          />
        ))
      }
    </div>
  </section>

  <!-- Quote form section -->
  <section id="contacto" class="mx-layout my-10 flex flex-col space-y-4 md:flex-row md:items-center md:gap-10">
    <div class="w-full md:w-1/2">
      <h2 class="text-titles-2 text-primary font-semibold">¿Necesitas ayuda? Estamos para servirte</h2>
      <div class="mt-10 flex h-full items-center gap-6">
        <img src="/icons/process_contact.svg" alt="Process bar" />
        <div class="flex h-full flex-col space-y-18">
          <p class="text-sm">Rellena el formulario y cuentanos sobre tu proyecto</p>
          <div class="flex flex-col gap-1">
            <p class="text-sm">
              Envíanos un mensaje o llámanos con una breve descripción para corresponder tu llamada:
            </p>
            <ul>
              <li>
                <a class="flex items-center gap-2 text-sm text-blue-600 underline" href=`mailto:${CONTACT_EMAIL}`>
                  <span class="block h-4 w-4 bg-blue-500 mask-[url('/icons/mail.svg')] mask-contain"></span>
                  {CONTACT_EMAIL}
                </a>
              </li>
              <li>
                <a class="flex items-center gap-2 text-sm text-blue-600 underline" href=`tel:${CONTACT_PHONE.value}`>
                  <span class="block h-4 w-4 bg-blue-500 mask-[url('/icons/phone.svg')] mask-contain"></span>
                  {CONTACT_PHONE.string}
                </a>
              </li>
              <li>
                <a
                  class="flex items-center gap-2 text-sm text-blue-600 underline"
                  href=`https://wa.me/${CONTACT_PHONE.value}`
                >
                  <span class="block h-4 w-4 bg-blue-500 mask-[url('/icons/whatsapp.svg')] mask-contain"></span>WhatsApp
                </a>
              </li>
            </ul>
          </div>
          <p class="text-sm">Te contactaremos lo antes posible</p>
        </div>
      </div>
      <p class="mt-10 text-sm">
        Cuéntanos lo que necesitas, te contactamos para afinar los detalles y recibirás una oferta personalizada en el
        menor tiempo posible.
      </p>
    </div>
    <div class="w-full md:w-1/2">
      <QuoteForm />
    </div>
  </section>
</Layout>

<script>
  const panels = document.querySelectorAll<HTMLElement>(".servicio-panel");
  const dots = document.querySelectorAll<HTMLElement>(".service-dot");
  const total = panels.length;
  let currentIndex = 0;

  function goTo(targetIndex: number) {
    if (targetIndex === currentIndex) return;
    panels[currentIndex].style.opacity = "0";
    panels[currentIndex].style.pointerEvents = "none";
    dots[currentIndex]?.classList.remove("bg-white", "scale-125");
    panels[targetIndex].style.opacity = "1";
    panels[targetIndex].style.pointerEvents = "auto";
    dots[targetIndex]?.classList.add("bg-white", "scale-125");
    currentIndex = targetIndex;
  }

  // Initialize first dot
  dots[0]?.classList.add("bg-white", "scale-125");

  // Dot click navigation
  dots.forEach((dot, i) => {
    dot.addEventListener("click", () => goTo(i));
  });

  // Click anywhere on the section to advance (wraps around)
  const section = document.getElementById("servicios")!;
  section.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target.closest("[data-dot]")) return;
    goTo((currentIndex + 1) % total);
  });

  // "About us" buttons → jump to specific service
  document.querySelectorAll<HTMLElement>("[data-goto-service]").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      e.preventDefault();
      const index = parseInt(btn.dataset.gotoService ?? "0", 10);
      document.getElementById("servicios")?.scrollIntoView({ behavior: "smooth" });
      // wait for scroll to finish before switching panel
      setTimeout(() => goTo(index), 400);
    });
  });
</script>
